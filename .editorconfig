# Editor settings matching the code as it is written (see also .clang-format)
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h,c,lua,cmake}]
max_line_length = 120

[CMakeLists.txt]
max_line_length = 120

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
